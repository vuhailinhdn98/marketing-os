# Marketing OS — biến môi trường (sao chép giá trị cần dùng vào phần Environment của nơi triển khai).
# Ứng dụng KHÔNG tự đọc file .env; trên máy cá nhân có thể bỏ trống tất cả.

# Thư mục lưu CSDL SQLite và ảnh/video. Trên cloud BẮT BUỘC trỏ vào ổ đĩa bền (vd Render Disk mount tại /var/data).
# Mặc định: data/runtime trong thư mục dự án.
DATA_DIR=

# Email quản trị, cách nhau bởi dấu phẩy. NÊN đặt khi chạy trên Internet;
# nếu bỏ trống, tài khoản đăng ký đầu tiên trở thành quản trị.
ADMIN_EMAILS=

# Cho phép người lạ tự tạo tài khoản (1/0). Đặt 0 sau khi đã tạo đủ tài khoản cho nhóm.
ALLOW_REGISTRATION=1

# Đăng nhập bằng Google (tùy chọn): OAuth Client ID loại "Web application" trên Google Cloud Console,
# thêm địa chỉ website vào "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Gemini API key dùng chung của máy chủ (tùy chọn). Mặc định chỉ quản trị dùng được;
# đặt SHARE_SERVER_GEMINI_KEY=1 nếu muốn mọi tài khoản dùng chung (tốn hạn mức của bạn).
GEMINI_API_KEY=
SHARE_SERVER_GEMINI_KEY=0

# Số ngày giữ phiên đăng nhập.
SESSION_DAYS=30

# Cho phép tải trang web đối thủ khi lập hồ sơ đối thủ (có chặn địa chỉ nội bộ). 0 để tắt.
ALLOW_WEB_FETCH=1

# Múi giờ dùng cho "hôm nay", lịch nội dung, tháng ngân sách.
APP_TIMEZONE=Asia/Ho_Chi_Minh

LOG_LEVEL=INFO
